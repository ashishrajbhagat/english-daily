# Cloud login + progress sync (optional). Supabase -> Settings -> API Keys
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) or the legacy anon key. Never the secret key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Needed only for the "Delete my account" button. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Your public site URL (used for SEO, sitemap and share images), e.g. https://english-daily.vercel.app
NEXT_PUBLIC_SITE_URL=
# Optional privacy-friendly analytics (plausible.io). Leave empty to disable.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Background reminders (push). Generate keys once with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Any long random string. Also add it as a GitHub secret named CRON_SECRET (see .github/workflows/reminders.yml)
CRON_SECRET=

# Optional AI features (AI Partner, AI coach, AI writing feedback). Works with any OpenAI-compatible provider, including FREE tiers.
# Leave these empty to keep AI switched off; the rest of the app does not need them.
# Examples (check the provider's page for current free models and limits):
#   Groq:        AI_BASE_URL=https://api.groq.com/openai/v1
#   OpenRouter:  AI_BASE_URL=https://openrouter.ai/api/v1   (free models end with :free)
#   Gemini:      AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Optional: shows a "Feedback" link in the footer and is used on the Privacy page
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional: set to 1 to show "Continue with Google" (first enable the Google provider in Supabase, see README)
NEXT_PUBLIC_GOOGLE_LOGIN=
